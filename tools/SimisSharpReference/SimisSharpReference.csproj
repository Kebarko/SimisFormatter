<Project Sdk="Microsoft.NET.Sdk">

  <!-- Formats SIMIS files with SimisSharp, as the reference for the corpus check (npm run corpus). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version the port is based on. Keep it equal to "Ported from" in CLAUDE.md. -->
    <PackageReference Include="SimisSharp" Version="0.1.0" />
  </ItemGroup>

</Project>
